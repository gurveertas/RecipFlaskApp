# Copy this file to `.env` and fill in your keys. `.env` is gitignored and read
# server-side only — never sent to the browser. Real environment variables
# (e.g. systemd Environment=) take precedence over anything set here.

# Web search, for Live-mode source retrieval. Get one at https://serper.dev
SERPER_API_KEY=

# LLM for Live-mode draft generation. Set ONE provider below.
#
# Google Gemini — FREE tier, no credit card. Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Optional: override the Gemini model (defaults to gemini-2.5-flash).
GEMINI_MODEL=
#
# Any other OpenAI-compatible provider (Groq, OpenRouter, local Ollama): set all
# three and it takes precedence over GEMINI_API_KEY. Examples:
#   Groq        -> https://api.groq.com/openai/v1
#   OpenRouter  -> https://openrouter.ai/api/v1
#   Ollama      -> http://localhost:11434/v1   (LLM_API_KEY can be any value)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
#
# Anthropic / Claude alternative: https://console.anthropic.com (Settings -> API Keys)
# ANTHROPIC_API_KEY=

# Don't write __pycache__/.pyc bytecode caches for project code.
PYTHONDONTWRITEBYTECODE=1

# Serper balance when in-app tracking began (before the first ApiUsage row).
# The app estimates "credits left" as this minus tracked spend. Update after a top-up.
SERPER_CREDITS_START=
